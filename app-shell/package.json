{
  "name": "emmerdale-agriculture-app",
  "version": "1.0.0",
  "private": true,
  "description": "Native app-store shell (Capacitor) for emmerdaleagriculture.com. Wraps the live website in a native container for iOS/Android rather than re-implementing it — the app always shows exactly what's live on the site, with no separate web build step. Boots at /app instead of the marketing homepage.",
  "scripts": {
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "sync": "cap sync",
    "check": "node scripts/check-config.mjs",
    "assets:ios": "capacitor-assets generate --ios --iconBackgroundColor '#17330d' --splashBackgroundColor '#17330d'",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor '#17330d' --splashBackgroundColor '#17330d'"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "tar": "7.5.22",
    "sharp": "0.35.4",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "typescript": "5.9.3"
  }
}
